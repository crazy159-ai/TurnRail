{
  "name": "turnrail",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "license": "MIT",
  "description": "A lightweight conversation navigator for long AI chats (Chrome Extension, Manifest V3).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:browser": "playwright test",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run build && npm test",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
