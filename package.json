{
  "name": "turnrail",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A lightweight conversation navigator for long AI chats (Chrome Extension, Manifest V3).",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/*.test.ts\"",
    "zip": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Compress-Archive -Path 'dist/*' -DestinationPath 'turnrail.zip' -Force\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
