{
  "name": "turnrail",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "description": "A lightweight conversation navigator for long AI chats (Chrome Extension, Manifest V3).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/unit/*.test.ts\"",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
